# Local development only; replace passwords before using shared environments.
FRONTEND_PORT=3000
BACKEND_PORT=8000
METADATA_PASSWORD=local-metadata-only
DEMO_ADMIN_PASSWORD=local-demo-admin-only
DEMO_READER_PASSWORD=local-demo-reader-only
# Local-only Fernet key. Generate a unique key before any shared deployment.
CREDENTIAL_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# LLM configuration: Gemini is primary for structured generation; OpenRouter is the
# bounded fallback for Gemini timeout/rate-limit failures and embeddings.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Set a real key only in a local, uncommitted .env file.
OPENROUTER_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_FALLBACK_PROVIDER=openrouter
LLM_FALLBACK_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_DIMENSIONS=1536
MODEL_CONFIG_VERSION=v1
PROVIDER_TIMEOUT_SECONDS=30
DATASOURCE_PROFILE_MAX_ROWS=1000
DATASOURCE_PROFILE_TIMEOUT_MS=10000
DATASOURCE_PROFILE_ENUM_MAX_DISTINCT=20
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SIMILARITY=0.2
RETRIEVAL_STRATEGY=hybrid
RETRIEVAL_SEMANTIC_WEIGHT=0.65
RETRIEVAL_LEXICAL_WEIGHT=0.35
RETRIEVAL_HYBRID_RELATIVE_THRESHOLD=0.64
RETRIEVAL_CONFIG_VERSION=v2-hybrid
RETRIEVAL_MAX_ENTITIES=8
RETRIEVAL_MAX_FIELDS_PER_ENTITY=24
RETRIEVAL_MAX_RELATIONSHIP_HOPS=3
RELATIONSHIP_INFERRED_MIN_CONFIDENCE=0.8
QUERY_MAX_REPAIR_ATTEMPTS=2
